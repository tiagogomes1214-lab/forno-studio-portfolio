# Forno Studio — Discloud GitHub Integration
# Reserve um subdominio no painel da Discloud e altere o ID abaixo
# antes do primeiro deploy. Nao inclua .discloud.app no ID.
NAME=Forno Studio
TYPE=site
MAIN=package.json
RAM=1024
VERSION=latest
BUILD=npm run build
START=npm run start
AUTORESTART=true
ID=SUBDOMINIO_RESERVADO
