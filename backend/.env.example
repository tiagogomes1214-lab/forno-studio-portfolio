# Local settings. For a public deployment, generate a unique long admin password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Local development uses SQLite. Set DATABASE_URL to your hosted PostgreSQL URL for deployment.
DATABASE_URL=sqlite:///./pizza.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public portfolio safety: set DEMO_MODE=true on the hosted backend.
# In demo mode, public orders are anonymized and online payments are disabled.
DEMO_MODE=false

# Mercado Pago (leave blank during public portfolio demo).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
FRONTEND_PUBLIC_URL=http://localhost:3000
